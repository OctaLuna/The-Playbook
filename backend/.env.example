# Copiar a backend/.env y completar localmente. Nunca commitear .env (ver .gitignore).

# Postgres — debe coincidir con las credenciales de infra/docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://playbook:playbook@localhost:5432/playbook

# Redis
REDIS_URL=redis://localhost:6379/0

# AWS Bedrock — autenticación vía IAM (rol dedicado o `aws sso login`), nunca una API key
# suelta (Art. VI). boto3 toma las credenciales del entorno/perfil AWS estándar
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_SESSION_TOKEN o AWS_PROFILE); estas dos
# variables solo le dicen a la app qué región y qué modelo invocar.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Frontend local, agregar dominios exactos separados por coma en cada entorno.
CORS_ORIGINS=http://localhost:3000

# News API es opcional; sin clave se usan los feeds RSS configurados.
NEWS_API_KEY=
# URLs separadas por coma; nunca incluir credenciales en las URLs.
NEWS_RSS_FEEDS=

# T025: tasa máxima de fallos en la muestra manual (0..1). Vacío desactiva alertas.
RAG_GROUNDEDNESS_ALERT_THRESHOLD=
