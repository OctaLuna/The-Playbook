# Normaliza los finales de línea: LF en el repositorio, nativo en el working copy.
# Sin esto, un equipo mixto Windows/Linux produce diffs de archivos enteros por CRLF.
* text=auto eol=lf

# Scripts que deben conservar LF siempre (los ejecuta Node o bash).
*.mjs   text eol=lf
*.js    text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binarios: nunca tocar.
*.png   binary
*.jpg   binary
*.pdf   binary
*.pkl   binary
*.joblib binary
